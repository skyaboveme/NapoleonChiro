---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpineProgress from '../components/SpineProgress.astro';

const teamPhotos = [
  { src: '/images/betsy.webp', name: 'Betsy', width: 1400, height: 1712 },
  { src: '/images/frenchessica.webp', name: 'Frenchessica', width: 860, height: 1030 },
  { src: '/images/jackie.webp', name: 'Jackie', width: 1400, height: 1626 },
  { src: '/images/mary.webp', name: 'Mary', width: 1400, height: 1662 },
  { src: '/images/robin.webp', name: 'Robin', width: 1400, height: 1676 },
  { src: '/images/tona.webp', name: 'Tona', width: 1400, height: 1688 },
];

const clinicPhotos = [
  { src: '/images/clinic-7336.webp', alt: 'Frey Clinic of Chiropractic', width: 1800, height: 1034 },
  { src: '/images/clinic-7359.webp', alt: 'Our Family Helping Yours. Frey Chiropractic', width: 1800, height: 1350 },
  { src: '/images/clinic-7369.webp', alt: 'Frey Chiropractic', width: 1800, height: 1350 },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Meet the Doctors | Frey Clinic of Chiropractic",
  "description": "Meet Dr. Timothy Frey, Dr. Christopher Peters, and Dr. Evan Plott, chiropractors serving Napoleon, OH and the surrounding Henry County communities.",
  "url": "https://www.freychiropractic.com/about/",
  "isPartOf": { "@id": "https://www.freychiropractic.com/#website" },
  "mainEntity": [
    {
      "@type": "Person",
      "name": "Dr. Timothy Frey",
      "jobTitle": "Doctor of Chiropractic",
      "worksFor": { "@id": "https://www.freychiropractic.com/#business" },
      "description": "Dr. Timothy Frey is a Doctor of Chiropractic serving the Napoleon, OH community. With years of experience in gentle, effective chiropractic care, Dr. Frey is committed to helping patients achieve optimal health."
    },
    {
      "@type": "Person",
      "name": "Dr. Christopher Peters",
      "jobTitle": "Doctor of Chiropractic",
      "worksFor": { "@id": "https://www.freychiropractic.com/#business" },
      "description": "Dr. Christopher Peters is a Doctor of Chiropractic at Frey Clinic of Chiropractic. He specializes in helping families in Napoleon, OH achieve better health through chiropractic care and acupuncture."
    },
    {
      "@type": "Person",
      "name": "Dr. Evan Plott",
      "jobTitle": "Doctor of Chiropractic",
      "worksFor": { "@id": "https://www.freychiropractic.com/#business" },
      "description": "Dr. Plott grew up in Carey, Ohio, and earned his Doctor of Chiropractic degree from Palmer College of Chiropractic in Port Orange, Florida. He focuses on the Gonstead technique and serves Napoleon and the surrounding communities."
    }
  ]
};
---

<BaseLayout
  title="Meet the Doctors"
  description="Meet Dr. Timothy Frey, Dr. Christopher Peters, and Dr. Evan Plott, chiropractors serving Napoleon, OH and the surrounding Henry County communities."
  schema={schema}
>
  <Header slot="header" />

  <section class="page-header">
    <div class="container">
      <h1 class="reveal">Meet the Doctors</h1>
      <span class="page-header__accent reveal"></span>
      <p class="reveal reveal-delay-1" style="max-width:36rem;">
        The team at Frey Clinic of Chiropractic is dedicated to helping you and your family achieve optimal health through gentle, effective care.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--sidebar">
      <div class="reveal">
        <img
          src="/images/team.webp"
          alt="Dr. Timothy Frey and Dr. Christopher Peters at Frey Clinic of Chiropractic"
          width="703"
          height="600"
          loading="lazy"
          class="img-elevated"
          style="width:100%; height:auto; filter:saturate(0.85);"
        />
      </div>
      <div class="reveal reveal-delay-1">
        <h2>Dr. Timothy Frey, DC</h2>
        <hr class="rule rule--accent" style="margin-block:var(--sp-4);" />
        <p>
          Dr. Timothy Frey has been serving the Napoleon, OH community for years, providing gentle and effective chiropractic care. He believes that chiropractic is one of the most powerful healthcare professions, built on the understanding that the body has an innate ability to heal itself when the spine and nervous system are properly aligned.
        </p>
        <p>
          Dr. Frey focuses on whole-family care — from pediatrics through the golden years — and is committed to helping every patient reach their health goals. His approach emphasizes safe, gentle adjustments tailored to each individual's needs.
        </p>
      </div>
    </div>
  </section>

  <hr class="rule container" />

  <section class="section">
    <div class="container grid grid--sidebar">
      <div class="reveal" style="order:2;">
        <img
          src="/images/team-thankyou.webp"
          alt="The team at Frey Clinic of Chiropractic"
          width="500"
          height="372"
          loading="lazy"
          class="img-elevated"
          style="width:100%; height:auto; filter:saturate(0.85);"
        />
      </div>
      <div class="reveal reveal-delay-1" style="order:1;">
        <h2>Dr. Christopher Peters, DC</h2>
        <hr class="rule rule--accent" style="margin-block:var(--sp-4);" />
        <p>
          Dr. Christopher Peters brings a passion for holistic health to Frey Clinic of Chiropractic. In addition to chiropractic adjustments, Dr. Peters offers acupuncture services, providing patients with complementary approaches to pain management and wellness.
        </p>
        <p>
          Dr. Peters is dedicated to creating a comfortable, welcoming environment where patients feel at ease. He works closely with each patient to develop personalized treatment plans that address their specific concerns and health objectives.
        </p>
      </div>
    </div>
  </section>

  <hr class="rule container" />

  <section class="section">
    <div class="container grid grid--sidebar">
      <div class="reveal">
        <img
          src="/images/evan-plott.webp"
          alt="Dr. Evan Plott"
          width="1400"
          height="1752"
          loading="lazy"
          class="img-elevated"
          style="width:100%; height:auto; filter:saturate(0.85);"
        />
      </div>
      <div class="reveal reveal-delay-1">
        <h2>Dr. Evan Plott, DC</h2>
        <hr class="rule rule--accent" style="margin-block:var(--sp-4);" />
        <p>
          Dr. Plott grew up in Carey, Ohio, and first became interested in chiropractic after injuring his back while weightlifting for football in high school. That experience sparked his curiosity about how chiropractic care could help people recover, move better, and return to the activities they enjoy.
        </p>
        <p>
          He attended Bowling Green State University, where he completed his undergraduate degree with a pre-medical focus and a minor in chemistry. He then earned his Doctor of Chiropractic degree from Palmer College of Chiropractic in Port Orange, Florida.
        </p>
        <p>
          Dr. Plott focuses on the Gonstead technique, a specific approach to chiropractic care that emphasizes thorough analysis and individualized adjustments. During his time at Palmer College of Chiropractic, he further developed his skills by attending weekend seminars in Florida, learning from experienced and respected Gonstead chiropractors.
        </p>
        <p>
          He has also attended seminars in Mount Horeb, Wisconsin, and plans to continue pursuing advanced training there throughout his career to further develop his knowledge and skills in the Gonstead technique.
        </p>
        <p>
          With his roots in Northwest Ohio, Dr. Plott is proud to serve Napoleon and the surrounding communities. He looks forward to building lasting relationships with his patients and helping them stay active and enjoy the activities that matter most to them.
        </p>
        <p>
          Outside the office, he enjoys watching football, hiking, and spending time with his wife. He is also a member of St. Augustine Catholic Church in Napoleon, Ohio and values being part of the local community.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="reveal">Team</h2>
      <hr class="rule rule--accent" />
      <div class="photo-grid photo-grid--team">
        {teamPhotos.map((photo) => (
          <figure class="photo-card reveal">
            <img
              src={photo.src}
              alt={photo.name}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              class="img-elevated"
            />
            <figcaption>{photo.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background-color:var(--white);">
    <div class="container">
      <h2 class="reveal">Clinic</h2>
      <hr class="rule rule--accent" />
      <div class="photo-grid">
        {clinicPhotos.map((photo) => (
          <figure class="photo-card reveal">
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              class="img-elevated"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal">
      <h2>Ready to start your journey to better health?</h2>
      <p>We welcome new patients and look forward to meeting you.</p>
      <a href="/schedule/" class="btn btn--arrow">Schedule an Appointment</a>
    </div>
  </section>

  <Footer slot="footer" />
  <SpineProgress slot="spine" />
</BaseLayout>
