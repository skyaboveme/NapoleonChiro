---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpineProgress from '../components/SpineProgress.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Frey Clinic of Chiropractic",
  "description": "Contact Frey Clinic of Chiropractic in Napoleon, OH. Call (419) 592-7966 or visit us at 390 Independence Dr.",
  "url": "https://www.freychiropractic.com/contact/",
  "mainEntity": {
    "@type": "Chiropractor",
    "@id": "https://www.freychiropractic.com/#business"
  }
};
---

<BaseLayout
  title="Contact"
  description="Contact Frey Clinic of Chiropractic in Napoleon, OH. Call (419) 592-7966 or visit us at 390 Independence Dr, Napoleon OH 43545."
  schema={schema}
>
  <Header slot="header" />

  <section class="page-header">
    <div class="container">
      <h1 class="reveal">Contact us</h1>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div class="reveal">
        <div class="info-block">
          <p class="info-block__label">Address</p>
          <p class="info-block__value">
            390 Independence Dr<br />
            Napoleon, OH 43545
          </p>
        </div>

        <div class="info-block">
          <p class="info-block__label">Phone</p>
          <p class="info-block__value">
            <a href="tel:4195927966" style="font-size:var(--text-2xl); font-family:var(--font-heading);">(419) 592-7966</a>
          </p>
        </div>

        <div class="info-block">
          <p class="info-block__label">Office Hours</p>
          <div class="info-block__value">
            <table style="line-height:2;">
              <tr><td style="padding-right:var(--sp-5);">Monday</td><td>8:45am – 11:30am, 1:30pm – 5:30pm</td></tr>
              <tr><td>Tuesday</td><td>8:45am – 11:30am, 1:30pm – 5:30pm</td></tr>
              <tr><td>Wednesday</td><td>8:45am – 11:30am, 1:30pm – 5:30pm</td></tr>
              <tr><td>Thursday</td><td>8:45am – 11:30am, 1:30pm – 5:30pm</td></tr>
              <tr><td>Friday</td><td>Closed</td></tr>
              <tr><td>Saturday</td><td>Closed</td></tr>
              <tr><td>Sunday</td><td>Closed</td></tr>
            </table>
          </div>
        </div>

        <div class="info-block">
          <p class="info-block__value">
            <a href="https://maps.app.goo.gl/QUrM6KDh1Ek4TdLj7/" target="_blank" rel="noopener" class="link-draw" style="font-weight:600;">Get Directions</a>
          </p>
        </div>
      </div>

      <div class="reveal reveal-delay-1">
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3019.5!2d-84.1276!3d41.3867!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDHCsDIzJzEyLjEiTiA4NMKwMDcnMzkuNCJX!5e0!3m2!1sen!2sus!4v1!5m2!1sen!2sus"
            title="Frey Clinic of Chiropractic location in Napoleon, OH"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal">
      <h2>Ready to schedule?</h2>
      <p>Request your appointment online or give us a call.</p>
      <div style="display:flex; gap:var(--sp-4); justify-content:center; flex-wrap:wrap;">
        <a href="/schedule/" class="btn">Request an Appointment</a>
        <a href="tel:4195927966" class="btn" style="background-color:var(--white); color:var(--ink); border-color:var(--white);">Call (419) 592-7966</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <SpineProgress slot="spine" />
</BaseLayout>
