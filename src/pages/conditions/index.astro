---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SpineProgress from '../../components/SpineProgress.astro';

const conditions = [
  { name: 'Back Pain', href: '/conditions/back-pain/', desc: 'Chiropractic treatment for back pain. Find relief without drugs or surgery.' },
  { name: 'Neck Pain', href: '/conditions/neck-pain/', desc: 'Chiropractic treatment for neck pain.' },
  { name: 'Headaches & Migraines', href: '/conditions/headaches-migraines/', desc: 'Chiropractic treatment for headaches and migraines.' },
  { name: 'Sciatica', href: '/conditions/sciatica/', desc: 'Chiropractic treatment for sciatica and sciatic nerve pain.' },
  { name: 'Scoliosis', href: '/conditions/scoliosis/', desc: 'Chiropractic care for scoliosis.' },
  { name: 'Disc Injury', href: '/conditions/disc-injury/', desc: 'Chiropractic treatment for disc injuries, herniated discs, and bulging discs.' },
  { name: 'Whiplash', href: '/conditions/whiplash/', desc: 'Chiropractic treatment for whiplash injuries.' },
  { name: 'Shoulder Pain', href: '/conditions/shoulder-pain/', desc: 'Chiropractic treatment for shoulder pain.' },
  { name: 'Arm and Leg Pain', href: '/conditions/arm-leg-pain/', desc: 'Chiropractic treatment for arm and leg pain.' },
  { name: 'Carpal Tunnel', href: '/conditions/carpal-tunnel/', desc: 'Chiropractic treatment for carpal tunnel syndrome.' },
  { name: 'Vertigo', href: '/conditions/vertigo/', desc: 'Chiropractic treatment for vertigo and dizziness.' },
  { name: 'Work Injury', href: '/conditions/work-injury/', desc: 'Chiropractic treatment for work-related injuries.' },
];
---

<BaseLayout
  title="Conditions"
  description="Conditions treated at Frey Clinic of Chiropractic in Napoleon, OH, including back pain, neck pain, headaches, sciatica, scoliosis, and work injuries."
>
  <Header slot="header" />

  <section class="page-header page-header--image">
    <div class="page-header__bg">
      <img src="/images/clinic-7336.webp" alt="Front entrance and ramp at Frey Clinic of Chiropractic in Napoleon, Ohio" width="1800" height="1034" />
    </div>
    <div class="container">
      <h1 class="reveal">Conditions we treat</h1>
      <span class="page-header__accent reveal"></span>
      <p class="reveal reveal-delay-1" style="max-width:36rem;">
        Our Napoleon chiropractors help with the conditions below. Choose one to learn how care can help.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="service-cards reveal-stagger">
        {conditions.map(c => (
          <a href={c.href} class="service-card" style="text-decoration:none;">
            <p class="service-card__title">{c.name}</p>
            <p class="service-card__desc">{c.desc}</p>
            <span class="service-card__link">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container reveal">
      <h2>Not sure where to start?</h2>
      <p>Tell us what is going on and we will help you find the right next step.</p>
      <a href="/contact/" class="btn btn--arrow">Contact Us</a>
    </div>
  </section>

  <Footer slot="footer" />
  <SpineProgress slot="spine" />
</BaseLayout>
