import ServiceLayout from '../../layouts/ServiceLayout.astro';
---

<ServiceLayout title="Prenatal Chiropractic" description="Safe, supportive chiropractic care during pregnancy at Frey Clinic of Chiropractic in Napoleon, OH." heroImage="/src/assets/images/hero-prenatal.jpg" heroAlt="Supportive prenatal chiropractic care during pregnancy">

<p>
  Pregnancy changes your body in profound ways. As your center of gravity shifts, your spine and pelvis adapt to support the growing weight. These changes can lead to discomfort, pain, and misalignment. Prenatal chiropractic care helps your body adapt more comfortably throughout pregnancy.
</p>

<hr class="rule rule--accent" style="margin-block:var(--sp-6);" />

<h2>Benefits during pregnancy</h2>
<ul style="list-style:disc; padding-left:var(--sp-5); margin-bottom:var(--sp-5);">
  <li style="margin-bottom:var(--sp-2);">Reduced back and pelvic pain</li>
  <li style="margin-bottom:var(--sp-2);">Improved comfort during all trimesters</li>
  <li style="margin-bottom:var(--sp-2);">Better pelvic alignment for an easier delivery</li>
  <li style="margin-bottom:var(--sp-2);">Reduced nausea in some patients</li>
  <li style="margin-bottom:var(--sp-2);">Shorter labor and delivery times</li>
</ul>

<h2>Safe and gentle</h2>
<p>
  Our chiropractors are experienced in working with pregnant patients. We use techniques and tables specifically designed for pregnancy, ensuring both your comfort and safety. Many OB-GYNs recommend chiropractic care as part of a healthy pregnancy.
</p>

</ServiceLayout>
